# Beispiel: NIEMALS echte Keys ins Git einchecken. Kopieren nach .env (wird von git ignoriert).
# M0: Nur development | test | staging. ENVIRONMENT=live verweigert den Start.
ENVIRONMENT=development
PORT=8787
HOST=127.0.0.1
APP_PUBLIC_ORIGIN=http://localhost:8787

# --- 0-€-Policy (Fail-closed: nur der exakte Wert "true" schaltet etwas ein) ---
MAX_NEW_MONTHLY_FIXED_COST_EUR=0
ALLOW_PAID_APIS=false
ALLOW_AUTO_UPGRADE=false
ALLOW_PAID_ADS=false
ALLOW_NEW_FINANCIAL_COMMITMENTS=false
LIVE_SALES_ENABLED=false
AUTO_MARKETING_OUTREACH=false
ALLOW_UNREVIEWED_DEPLOY=false

# Angebotsgrenzen (Minor Units, z. B. Cent)
QUOTE_CURRENCY=EUR
QUOTE_MIN_MINOR=5000
QUOTE_MAX_MINOR=200000
QUOTE_MIN_MARGIN_BPS=3000
ALLOWED_CAPABILITIES=b2b-calc-csv

# --- Speicher ---
DATABASE_URL=./data/infinity-earn.sqlite
ARTIFACTS_DIR=./data/artifacts

# --- Owner-Login: Hash mit `npm run owner:password` erzeugen ---
OWNER_PASSWORD_HASH=NOT_SET

# --- Signaturschlüssel (mind. 32 Zeichen, zufällig) ---
DOWNLOAD_SIGNING_KEY=NOT_SET
MOCK_WEBHOOK_SECRET=NOT_SET

# --- Zahlungen: M0 nur Mock-Provider. Stripe-Testmodus folgt in M2. ---
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=NOT_SET
STRIPE_WEBHOOK_SECRET=NOT_SET

# --- Recht/Steuern: bis M3 nicht konfiguriert -> keine USt-Berechnung, nur Testbelege ---
LEGAL_JURISDICTION=NOT_CONFIGURED
OWNER_BUSINESS_STATUS=NOT_VERIFIED
INVOICE_MODE=TEST_ONLY
PAYOUT_MODE=PROVIDER_MANAGED_ONLY
SDI_CHANNEL_CONFIGURED=false
TAX_RESERVE_ESTIMATE_BPS=

# --- KI / Free-Tier-Kontingente (vom Eigentümer gepflegte Schätzwerte) ---
# 0 = keine automatisch gestarteten KI-Jobs (fail-closed). Claude-Abo ist keine API.
AI_DAILY_TASK_LIMIT=0
FREE_TIER_DAILY_REQUEST_LIMIT=100000
FREE_TIER_THROTTLE_AT_BPS=8000
